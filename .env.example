# Copy this file to .env.local and fill in your Supabase project credentials.
# Found under Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ or they will be
# exposed to the browser. Used by the /devside admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional. Once a custom domain is bought and its wildcard DNS
# (*.yourdomain.com) points at this Vercel project, set this to that domain
# (no protocol, no subdomain) to let each shop's website be reached at
# <slug>.yourdomain.com instead of yourdomain.com/site/<slug>. Leave unset
# until then — the subdomain routing in src/middleware.ts is a no-op without it.
# ROOT_DOMAIN=yourdomain.com
